{
  "name": "jubitmind",
  "version": "0.79.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Local AI Interaction Monitor & Audit Tool",
  "author": "Jubit AI (https://jubit.ai)",
  "homepage": "https://github.com/M1zwell/jubitmind",
  "repository": {
    "type": "git",
    "url": "https://github.com/M1zwell/jubitmind.git"
  },
  "main": "dist-electron-ts/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --port 8081",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server-build.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "preview": "vite preview --port 8081",
    "setup:sidecar": "cd sidecar && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
    "sidecar": "cd sidecar && . .venv/bin/activate && python3 main.py",
    "start:all": "concurrently \"npm start\" \"npm run sidecar\"",
    "docker:build": "docker build -t jubitmind .",
    "docker:run": "docker run -p 3000:3000 -v ~/.claude:/data/.claude:ro jubitmind",
    "docker:compose": "docker compose up -d",
    "electron:build-ts": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "electron:dev": "npm run build && npm run electron:build-ts && electron .",
    "electron:build": "npm run build && npm run electron:build-ts && electron-builder --config electron-builder.yml",
    "electron:build:mac": "npm run build && npm run electron:build-ts && electron-builder --mac --config electron-builder.yml",
    "electron:build:win": "npm run build && npm run electron:build-ts && electron-builder --win --config electron-builder.yml",
    "sidecar:build": "bash scripts/build-sidecar.sh",
    "sidecar:build:win": "scripts\\build-sidecar.bat",
    "electron:build:full": "npm run sidecar:build && npm run electron:build",
    "electron:build:full:mac": "npm run sidecar:build && npm run electron:build:mac",
    "electron:build:full:win": "npm run sidecar:build:win && npm run electron:build:win"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "electron-store": "^11.0.2",
    "express": "^4.21.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.468.0",
    "protobufjs": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
