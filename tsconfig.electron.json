{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-electron-ts",
    "rootDir": "electron",
    "declaration": false
  },
  "include": ["electron/*.ts"]
}
